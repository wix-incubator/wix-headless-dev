---
import Layout from "../layouts/Layout.astro";
import Welcome from "../components/Welcome.astro";

// The page embeds a time-sensitive booking-slot window, so cap how long a
// cached copy can live (the BaaS HTML cache is only purged on release, which
// can be weeks apart). BookEngineer also self-heals client-side, but a short
// TTL keeps the served HTML close to fresh.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=86400",
);
---

<Layout>
	<Welcome />
</Layout>
